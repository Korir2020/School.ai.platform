
# Off-site backups are disabled unless all required secrets/bucket values are set.
OFFSITE_S3_BUCKET=
OFFSITE_S3_ENDPOINT_URL=
OFFSITE_S3_REGION=us-east-1
OFFSITE_S3_PREFIX=marian-backups
OFFSITE_S3_ACCESS_KEY=
OFFSITE_S3_SECRET_KEY=
# BACKUP_ENCRYPTION_KEY: 32-byte AES key encoded as 64 hex chars or base64.
BACKUP_ENCRYPTION_KEY=
# BACKUP_MANIFEST_HMAC_KEY: base64-encoded secret, at least 32 decoded bytes.
BACKUP_MANIFEST_HMAC_KEY=
BACKUP_RETENTION_DAYS=30
BACKUP_RETRY_ATTEMPTS=3
BACKUP_RETRY_BASE_SECONDS=1
BACKUP_LEASE_SECONDS=7200
# PostgreSQL native tools, available on the backup/restore worker host.
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore
# Operator declarations only; these do not create or verify an external schedule/drill.
BACKUP_SCHEDULER_DECLARED=false
BACKUP_NEXT_SCHEDULED_AT=
BACKUP_LAST_RESTORE_DRILL_AT=
# Protected append-only restore audit log path on the controlled restore host.
BACKUP_RESTORE_AUDIT_LOG=
